<Project Sdk="Microsoft.NET.Sdk">

    <!-- Komet.Rendering: the OpenGL render path: culling, pools, shaders, shadows, frame pacing, GPU compute helpers. Settings, game references and the analyzer: ../Komet.Module.props -->
    <Import Project="../Komet.Module.props"/>

    <!-- The modules this one builds on; a module never references one above it -->
    <ItemGroup>
        <ProjectReference Include="../Komet.Core/Komet.Core.csproj"/>
        <ProjectReference Include="../Komet.Diagnostics/Komet.Diagnostics.csproj"/>
    </ItemGroup>

    <!-- The compute shaders, read by GpuShaders; the tests compile the same files to SPIR-V -->
    <ItemGroup>
        <EmbeddedResource Include="Gpu/Shaders/*.comp" LogicalName="Komet.Gpu.Shaders.%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
