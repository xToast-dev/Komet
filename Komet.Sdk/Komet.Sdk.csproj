<Project Sdk="Microsoft.NET.Sdk">

    <!-- The Shader Studio (editor, explorer, passes, game values, engine view) and its backend (projects, overrides,
         builds, per-pass timing): a module of Komet like the others, the top one; KometModSystem starts it (KometSdk).
         Shared settings, game references and the analyzer: ../Komet.Module.props -->
    <Import Project="../Komet.Module.props"/>

    <ItemGroup>
        <ProjectReference Include="../Komet.Ui/Komet.Ui.csproj"/>
    </ItemGroup>

    <!-- The Engine view decompiles the player's own game assemblies at runtime (ICSharpCode.Decompiler, MIT); its two
         dependencies are in the runtime. Shipped in Komet's zip, loaded only when the view first opens. -->
    <ItemGroup>
        <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988"/>
        <None Include="$(NuGetPackageRoot)icsharpcode.decompiler/9.1.0.7988/lib/netstandard2.0/ICSharpCode.Decompiler.dll"
              Link="ICSharpCode.Decompiler.dll" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
        <!-- what mod authors read and start from: the Modding docs and the templates; Komet's Package ships them -->
        <None Include="assets/**"/>
    </ItemGroup>

</Project>
