<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/> <!-- RulesTests compile snippets with the analyzer -->
    </ItemGroup>

    <!-- The game API is copied next to the tests: the golden tests run the engine's culling against Komet's -->
    <ItemGroup>
        <ProjectReference Include="../Komet/Komet.csproj"/>
        <ProjectReference Include="../Komet.Rules/Komet.Rules.csproj"/>
        <Reference Include="VintagestoryAPI" HintPath="$(VsInstall)/VintagestoryAPI.dll"/>
        <Reference Include="0Harmony" HintPath="$(VsInstall)/Lib/0Harmony.dll"/>
        <Reference Include="VintagestoryLib" HintPath="$(VsInstall)/VintagestoryLib.dll"/>
        <Reference Include="VSEssentials" HintPath="$(VsInstall)/Mods/VSEssentials.dll"/>
        <Reference Include="VSSurvivalMod" HintPath="$(VsInstall)/Mods/VSSurvivalMod.dll"/>
        <Reference Include="OpenTK.Windowing.Desktop" HintPath="$(VsInstall)/Lib/OpenTK.Windowing.Desktop.dll"/>
        <Reference Include="OpenTK.Mathematics" HintPath="$(VsInstall)/Lib/OpenTK.Mathematics.dll"/>
        <Reference Include="Newtonsoft.Json" HintPath="$(VsInstall)/Lib/Newtonsoft.Json.dll"/> <!-- the game's, not a test host's --> <!-- Shape's JSON types carry its attributes --> <!-- the texture atlas code TessSafety patches uses it -->
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
        <Using Include="Komet.Test.Bench"/>
        <Using Include="Komet.Test.Chunks"/>
        <Using Include="Komet.Test.Core"/>
        <Using Include="Komet.Test.Diagnostics"/>
        <Using Include="Komet.Test.Hud"/>
        <Using Include="Komet.Test.Rendering"/>
        <Using Include="Komet.Test.Rigs"/>
        <Using Include="Komet.Test.Rules"/>
        <Using Include="Komet.Test.Shapes"/>
        <Using Include="Komet.Test.Tessellation"/>
        <Using Include="Komet.Test.World"/>
        <Using Include="Komet.Core"/>
        <Using Include="Komet.Rendering"/>
        <Using Include="Komet.Chunks"/>
        <Using Include="Komet.Tessellation"/>
        <Using Include="Komet.Shapes"/>
        <Using Include="Komet.World"/>
        <Using Include="Komet.Hud"/>
        <Using Include="Komet.Diagnostics"/>
        <Using Include="Komet.Bench"/>
    </ItemGroup>

    <!-- The installation the tests read: the golden animation tests take the game's own shapes from it, and the pre-JIT tests
         resolve the engine's dependencies where the game's own assembly resolver would look -->
    <ItemGroup>
        <AssemblyMetadata Include="VsInstall" Value="$(VsInstall)"/>
        <AssemblyMetadata Include="KometDir" Value="$(MSBuildThisFileDirectory)../Komet"/>
    </ItemGroup>

</Project>
