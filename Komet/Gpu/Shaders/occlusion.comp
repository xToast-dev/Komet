#version 460 core
// Occlusion test of the terrain ranges the frustum left, against a depth pyramid (hiz.comp): a range is hidden when the nearest
// point of its box lies behind the farthest depth under the box's screen rectangle. Conservative everywhere else: a box through
// the near plane, one off screen when the pyramid is another frame's, and one the pyramid cannot cover in 2x2 texels are visible.
// Counts into the frame's counters from flags.y on: ranges, triangles, hidden ranges, hidden triangles, then why the others stayed:
// through the near plane, off screen, in front of the pyramid, no level small enough (never, the last level is 1x1).
// The test against the previous frame's pyramid leaves its verdict per range; the test against this frame's then counts, into totals
// that are never cleared, the ranges the first hid although they are visible: culling by the previous frame would show them a
// frame late.
// Written for OpenGL and Vulkan alike: explicit bindings no two resources share, no loose uniforms.
layout(local_size_x = 64) in;

struct Range
{
    vec3 low;   // box corners, relative to the camera of this frame
    uint count; // indices
    vec3 high;
    uint first; // first index
};

layout(std140, binding = 14) uniform Params
{
    mat4 viewProjection; // of the frame the pyramid belongs to, camera-relative
    vec4 shift;          // xyz: this frame's camera minus that frame's
    ivec4 sizes;         // pyramid level 0 width, height, levels, ranges
    ivec4 flags;         // x: 1 = the pyramid is this frame's, so off-screen parts are hidden; y: first counter;
                         // z: 1 = the previous frame's test ran over these ranges before (its verdicts are there)
};

const uint Totals = 16u; // ranges compared, of them shown a frame late, their triangles, frames compared

layout(binding = 31) uniform sampler2D pyramid;

layout(std430, binding = 4) readonly buffer Ranges
{
    Range ranges[];
};

layout(std430, binding = 5) buffer Counters
{
    uint counters[];
};

layout(std430, binding = 6) buffer Verdicts
{
    uint verdicts[]; // 1: hidden by the previous frame's pyramid
};

const int Shown = 0, Near = 1, Offscreen = 2, InFront = 3, NoLevel = 4, IsHidden = 5;

int Test(Range range)
{
    vec3 low = range.low + shift.xyz, high = range.high + shift.xyz;
    vec2 lo = vec2(1.0), hi = vec2(-1.0);
    float nearest = 1.0;
    for (int corner = 0; corner < 8; corner++)
    {
        vec3 p = vec3((corner & 1) != 0 ? high.x : low.x, (corner & 2) != 0 ? high.y : low.y,
                      (corner & 4) != 0 ? high.z : low.z);
        vec4 clip = viewProjection * vec4(p, 1.0);
        if (clip.w <= 1e-4) return Near; // through or behind the near plane
        vec3 ndc = clip.xyz / clip.w;
        lo = min(lo, ndc.xy);
        hi = max(hi, ndc.xy);
        nearest = min(nearest, ndc.z * 0.5 + 0.5);
    }

    if (flags.x == 0 && (any(lessThan(lo, vec2(-1.0))) || any(greaterThan(hi, vec2(1.0))))) return Offscreen;
    vec2 size = vec2(sizes.xy);
    vec2 from = clamp(lo * 0.5 + 0.5, 0.0, 1.0) * size - 1.0, to = clamp(hi * 0.5 + 0.5, 0.0, 1.0) * size + 1.0;
    for (int at = 0; at < sizes.z; at++)
    {
        ivec2 edge = textureSize(pyramid, at) - 1; // the last texel holds what lies past it
        ivec2 first = clamp(ivec2(floor(from / float(1 << at))), ivec2(0), edge);
        ivec2 last = clamp(ivec2(floor(to / float(1 << at))), first, edge);
        if (any(greaterThan(last - first, ivec2(1)))) continue;
        float farthest = max(max(texelFetch(pyramid, first, at).r, texelFetch(pyramid, ivec2(last.x, first.y), at).r),
                             max(texelFetch(pyramid, ivec2(first.x, last.y), at).r, texelFetch(pyramid, last, at).r));
        return nearest > farthest ? IsHidden : InFront;
    }

    return NoLevel;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(sizes.w)) return;
    Range range = ranges[index];
    uint triangles = range.count / 3u, at = uint(flags.y);
    atomicAdd(counters[at], 1u);
    atomicAdd(counters[at + 1u], triangles);
    int result = Test(range);
    bool hidden = result == IsHidden;
    if (flags.x == 0) verdicts[index] = hidden ? 1u : 0u;
    else if (flags.z == 1)
    {
        if (index == 0u) atomicAdd(counters[Totals + 3u], 1u);
        atomicAdd(counters[Totals], 1u);
        if (!hidden && verdicts[index] == 1u)
        {
            atomicAdd(counters[Totals + 1u], 1u);
            atomicAdd(counters[Totals + 2u], triangles);
        }
    }

    if (!hidden)
    {
        atomicAdd(counters[at + 3u + uint(result)], 1u);
        return;
    }

    atomicAdd(counters[at + 2u], 1u);
    atomicAdd(counters[at + 3u], triangles);
}
