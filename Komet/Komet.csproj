<Project Sdk="Microsoft.NET.Sdk">

    <!-- The mod the game loads (Komet.dll: KometModSystem, MapTracking, Modules.cs) with modinfo.json and the assets; the
         code lives in the module projects it references, which the build copies beside it and Package ships in the zip.
         Settings, game references and the analyzer: ../Komet.Module.props -->
    <Import Project="../Komet.Module.props"/>

    <PropertyGroup>
        <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    </PropertyGroup>

    <!-- Every module, top down; the mod names them all (Modules.cs) -->
    <ItemGroup>
        <ProjectReference Include="../Komet.Ui/Komet.Ui.csproj"/>
        <ProjectReference Include="../Komet.Vulkan/Komet.Vulkan.csproj"/>
        <ProjectReference Include="../Komet.World/Komet.World.csproj"/>
        <ProjectReference Include="../Komet.Shapes/Komet.Shapes.csproj"/>
        <ProjectReference Include="../Komet.Chunks/Komet.Chunks.csproj"/>
        <ProjectReference Include="../Komet.Tessellation/Komet.Tessellation.csproj"/>
        <ProjectReference Include="../Komet.Rendering/Komet.Rendering.csproj"/>
        <ProjectReference Include="../Komet.Diagnostics/Komet.Diagnostics.csproj"/>
        <ProjectReference Include="../Komet.Core/Komet.Core.csproj"/>
    </ItemGroup>

    <!-- Stamped by CI (see .github/workflows/build.yml); a local build carries neither and the HUD shows plain Release -->
    <ItemGroup>
        <AssemblyMetadata Include="Channel" Value="$(KometChannel)" Condition="'$(KometChannel)' != ''"/>
        <AssemblyMetadata Include="Commit" Value="$(KometCommit)" Condition="'$(KometCommit)' != ''"/>
        <AssemblyMetadata Include="Built" Value="$(KometBuilt)" Condition="'$(KometBuilt)' != ''"/>
    </ItemGroup>

    <!-- The edition the HUD names, from modinfo.json's version at every build: a Debug build (VS Code's launch) is Development, a
         version with a suffix (3.0.0-pre1, 3.0.0-rc.2) a Pre-Build, a plain major.minor.patch a Release. A version of another shape
         fails the build. -->
    <Target Name="KometEdition" BeforeTargets="GetAssemblyAttributes">
        <PropertyGroup>
            <KometModInfo>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/modinfo.json'))</KometModInfo>
            <KometVersion>$([System.Text.RegularExpressions.Regex]::Match($(KometModInfo), '(?&lt;="version"\s*:\s*")[^"]*'))</KometVersion>
            <KometSuffix>$([System.Text.RegularExpressions.Regex]::Match($(KometVersion), '(?&lt;=^\d+\.\d+\.\d+-).+$'))</KometSuffix>
            <KometEdition Condition="'$(Configuration)' == 'Debug'">dev</KometEdition>
            <KometEdition Condition="'$(KometEdition)' == '' and '$(KometSuffix)' != ''">pre</KometEdition>
            <KometEdition Condition="'$(KometEdition)' == ''">release</KometEdition>
        </PropertyGroup>
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($(KometVersion), '^\d+\.\d+\.\d+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$'))"
               Text="modinfo.json: version '$(KometVersion)' is not major.minor.patch with an optional suffix (3.0.0, 3.0.0-pre1, 3.0.0-rc.2)"/>
        <ItemGroup>
            <AssemblyMetadata Include="Edition" Value="$(KometEdition)"/>
        </ItemGroup>
        <Message Importance="high" Text="Komet $(KometVersion): $(KometEdition) build"/>
    </Target>

    <ItemGroup>
        <!-- the templates' code is the mods' own, compiled by them; not part of Komet -->
        <Compile Remove="assets/**"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="modicon.png" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- `dotnet build -c Release -t:Package` (build.sh) builds, lays the mod out in ../Releases/<modid> (scripts/bench.sh loads it from
         there, beside the benchmark mod from Komet.Bench) and zips it as <modid>_<version>.zip. An explicit target, not one after every Release build: a Release build of the tests
         must neither replace the gate's zip nor delete the folder a bench is running from. -->
    <Target Name="Package" DependsOnTargets="ValidateJson;Build;KometEdition">
        <Error Condition="'$(Configuration)' != 'Release'" Text="Package takes a Release build: dotnet build -c Release -t:Package"/>
        <PropertyGroup>
            <ModId>$([System.Text.RegularExpressions.Regex]::Match($(KometModInfo), '(?&lt;="modid"\s*:\s*")[^"]+'))</ModId>
            <ReleaseRoot>$(MSBuildProjectDirectory)/../Releases</ReleaseRoot>
            <ReleaseDir>$(ReleaseRoot)/$(ModId)</ReleaseDir>
        </PropertyGroup>
        <Error Condition="'$(ModId)' == '' or '$(KometVersion)' == ''" Text="modinfo.json: modid and version must not be empty"/>
        <ItemGroup>
            <!-- the mod and every module assembly the build copied beside it, with their pdbs for stack-trace lines -->
            <ReleaseFile Include="$(TargetDir)Komet*.dll;$(TargetDir)Komet*.pdb;@(Content)"/>
            <ReleaseAsset Include="assets/**"/>
        </ItemGroup>
        <!-- only this mod's folder and zips: Komet.Bench lays the developer benchmark out beside it (Releases/kometbench) -->
        <ItemGroup>
            <ReleaseZip Include="$(ReleaseRoot)/$(ModId)_*.zip"/>
        </ItemGroup>
        <RemoveDir Directories="$(ReleaseDir)"/>
        <Delete Files="@(ReleaseZip)"/>
        <Copy SourceFiles="@(ReleaseFile)" DestinationFolder="$(ReleaseDir)"/>
        <Copy SourceFiles="@(ReleaseAsset)" DestinationFiles="@(ReleaseAsset->'$(ReleaseDir)/assets/%(RecursiveDir)%(Filename)%(Extension)')"/>
        <ZipDirectory SourceDirectory="$(ReleaseDir)" DestinationFile="$(ReleaseRoot)/$(ModId)_$(KometVersion).zip"/>
    </Target>

    <!-- The zip carries modinfo.json and the assets as they are, and the game parses them with Newtonsoft. The analyzer reads the lang
         files tolerantly, so the real parse happens here, with the game's own library: comments and single quotes pass, a missing comma
         fails the package. -->
    <Target Name="ValidateJson">
        <ItemGroup>
            <JsonFile Include="modinfo.json;assets/**/*.json"/>
        </ItemGroup>
        <ValidateJson Library="$(VsInstall)/Lib/Newtonsoft.Json.dll" Files="@(JsonFile)"/>
    </Target>

    <!-- An inline task compiles against netstandard, which cannot see the game's net6 Newtonsoft; so the parser is bound at run time -->
    <UsingTask TaskName="ValidateJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Library Required="true"/>
            <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true"/>
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Reflection"/>
            <Code Type="Fragment" Language="cs"><![CDATA[
                var parse = Assembly.LoadFrom(Library).GetType("Newtonsoft.Json.Linq.JToken", true).GetMethod("Parse", new[] { typeof(string) });
                foreach (var file in Files)
                {
                    try { parse.Invoke(null, new object[] { File.ReadAllText(file.ItemSpec) }); }
                    catch (TargetInvocationException e) { Log.LogError(null, null, null, file.ItemSpec, 0, 0, 0, 0, "invalid JSON: " + e.InnerException.Message); }
                }
            ]]></Code>
        </Task>
    </UsingTask>

</Project>
