{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [{ "src": "../../Komet.Core", "files": ["Komet.Core.csproj"] }],
      "dest": "api",
      "properties": { "Configuration": "Release" },
      "filter": "filter.yml",
      
      "namespaceLayout": "flattened",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["articles/**.md", "articles/toc.yml", "toc.yml", "*.md"] }
    ],
    "resource": [{ "files": ["images/**", "downloads/**"] }],
    "output": "_site",
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appName": "Komet",
      "_appTitle": "Komet API",
      "_appLogoPath": "images/komet.png",
      "_appFaviconPath": "images/komet.png",
      "_appFooter": "Komet for Vintage Story. Not affiliated with Anachronistic Games.",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
